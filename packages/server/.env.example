PORT=5200
HOST=0.0.0.0
# Local defaults — in Compose/K8s use service DNS (e.g. http://api-gateway:5100)
API_GATEWAY_URL=http://localhost:5100
REALTIME_GATEWAY_URL=http://localhost:5008
IMMERSIVE_URL=http://localhost:5174
# Runtime registry mutations (webhooks) — never overwrite packaged serviceRegistry.json
REGISTRY_DATA_PATH=./data/serviceRegistry.runtime.json
# Optional: raises GitHub API rate limits for /github/* proxies
# GITHUB_TOKEN=
